}
QTableWidget#passwordsTable::item {
    padding: 0 14px;
    border-bottom: 1px solid #EDF2EE;
}
QTableWidget#passwordsTable::item:selected {
    background: #E2EFE7;
    color: #174B35;
}
QTableWidget#passwordsTable QHeaderView {
    background: #F3F7F4;
    border: none;
}
QTableWidget#passwordsTable QHeaderView::section {
    background: #F3F7F4;
    color: #61796A;
    border: none;
    border-bottom: 1px solid #E1EAE4;
    padding: 13px 14px;
    font-size: 12px;
    font-weight: 600;
}
QTableWidget#passwordsTable QHeaderView::section:first {
    border-top-left-radius: 9px;
}
QTableWidget#passwordsTable QHeaderView::section:last {
    border-top-right-radius: 9px;
}
QTableWidget#passwordsTable QScrollBar:vertical {
    background: #F5F8F6;
    width: 10px;
    margin: 0;
    border: none;
}
QTableWidget#passwordsTable QScrollBar:horizontal {
    background: #F5F8F6;
    height: 10px;
    margin: 0;
    border: none;
}
