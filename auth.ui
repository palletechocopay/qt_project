  <property name="styleSheet">
   <string>QMainWindow, QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;DejaVu Sans&quot;, sans-serif;
    font-size: 14px;
    color: #213B32;
}
QWidget#centralwidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #EDF3EF, stop:1 #F8FAF8);
}
QStackedWidget, QWidget#loginPage, QWidget#registerPage,
QWidget#loginContent, QWidget#registerContent,
QWidget#loginBrand, QWidget#registerBrand {
    background: transparent;
    border: none;
}
QFrame#loginCard, QFrame#registerCard {
    background: #FFFFFF;
    border: 1px solid #DBE5DF;
    border-radius: 20px;
}
QLabel { background: transparent; border: none; }
QLabel#loginBrandMark, QLabel#registerBrandMark {
    background: #1D6E54;
    color: #FFFFFF;
    border-radius: 11px;
    font-size: 23px;
    font-weight: 600;
}
QLabel#loginBrandName, QLabel#registerBrandName {
    font-size: 21px;
    font-weight: 600;
    color: #183F30;
}
QLabel#loginEyebrow, QLabel#registerEyebrow {
    color: #56806D;
    font-size: 10px;
    font-weight: 600;
}
QLabel#loginTitle, QLabel#registerTitle {
    font-size: 27px;
    font-weight: 600;
    color: #173D2E;
}
QLabel#loginSubtitle, QLabel#registerSubtitle {
    font-size: 13px;
    color: #738178;
}
QLabel#loginUsernameLabel, QLabel#loginPasswordLabel,
QLabel#registerUsernameLabel, QLabel#registerPasswordLabel,
QLabel#registerConfirmLabel {
    font-size: 13px;
    font-weight: 600;
    color: #3D5147;
}
QLineEdit {
    background: #F8FAF8;
    color: #213B32;
    border: 1px solid #D6E0DA;
    border-radius: 9px;
    padding: 0 13px;
    selection-background-color: #246E56;
    selection-color: #FFFFFF;
}
QLineEdit:hover { border-color: #A6BCAF; }
QLineEdit:focus { background: #FFFFFF; border-color: #247A5C; }
QPushButton#loginButton, QPushButton#registerButton {
    background: #1D6E54;
    color: #FFFFFF;
    border: 2px solid #1D6E54;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    padding: 0 12px;
}
QPushButton#loginButton:hover, QPushButton#registerButton:hover {
    background: #185D46;
    border-color: #185D46;
}
QPushButton#loginButton:pressed, QPushButton#registerButton:pressed {
    background: #124A38;
    border-color: #124A38;
}
QPushButton#loginButton:focus, QPushButton#registerButton:focus {
    border-color: #8CC7AD;
}
QCheckBox {
    color: #63756A;
    font-size: 12px;
    spacing: 8px;
}
QLabel#registerLink, QLabel#loginLink {
    color: #738178;
    font-size: 12px;
}
QLabel#loginStatusLabel, QLabel#registerStatusLabel {
    font-size: 12px;
    color: #63756A;
}
QLabel[state=&quot;error&quot;] { color: #B44343; }
QLabel#loginStatusLabel[state=&quot;error&quot;],
QLabel#registerStatusLabel[state=&quot;error&quot;] { color: #B44343; }
QLabel#loginFooter, QLabel#registerFooter {
    font-size: 11px;
    color: #8A9990;
}

