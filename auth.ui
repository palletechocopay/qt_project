    min-height: 28px;
}
QTableWidget#passwordsTable QScrollBar::handle:horizontal {
    background: #C1D3C6;
    border-radius: 5px;
    min-width: 28px;
}
QTableWidget#passwordsTable QScrollBar::add-line,
QTableWidget#passwordsTable QScrollBar::sub-line {
